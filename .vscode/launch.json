{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TDMFirmware Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/TDMFirmware/Debug/TDMFirmware.elf",
            "device": "STM32G473CBTx",
            "svdFile": "",
            "openocdPath": "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.200.202505051030/tools/bin/openocd.exe",
            "gdbPath": "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.13.3.rel1.win32_1.0.0.202411081344/tools/bin/arm-none-eabi-gdb.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "searchDir": [
                "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.100.202501240831/resources/openocd/st_scripts"
            ],
            "preLaunchTask": "Build TDMFirmware",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "TDMFirmware Debug (OpenOCD, no build)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/TDMFirmware/Debug/TDMFirmware.elf",
            "device": "STM32G473CBTx",
            "svdFile": "",
            "openocdPath": "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.200.202505051030/tools/bin/openocd.exe",
            "gdbPath": "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.13.3.rel1.win32_1.0.0.202411081344/tools/bin/arm-none-eabi-gdb.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "searchDir": [
                "C:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.100.202501240831/resources/openocd/st_scripts"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "그리퍼 시뮬: 설정 패널",
            "type": "debugpy",
            "request": "launch",
            "module": "sim_gripper.panel",
            "cwd": "${workspaceFolder}",
            "python": "C:/ml_env/Scripts/python.exe",
            "console": "integratedTerminal"
        },
        {
            "name": "그리퍼 시뮬: 시나리오 선택 실행",
            "type": "debugpy",
            "request": "launch",
            "module": "sim_gripper.viewer",
            "args": ["${input:gripperScenario}", "--actuator", "${input:gripperActuator}", "--sensor", "${input:gripperSensor}"],
            "cwd": "${workspaceFolder}",
            "python": "C:/ml_env/Scripts/python.exe",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "gripperScenario",
            "type": "pickString",
            "description": "시나리오",
            "options": ["E1_metal", "E2_hand", "E2_egg", "E3_sponge", "E3_small", "E3_large", "E4_disturb"],
            "default": "E1_metal"
        },
        {
            "id": "gripperActuator",
            "type": "pickString",
            "description": "액추에이터",
            "options": ["tendon", "pneumatic"],
            "default": "tendon"
        },
        {
            "id": "gripperSensor",
            "type": "pickString",
            "description": "센서 모드 (pipeline = v4 MoE, ideal = 이상 센서)",
            "options": ["pipeline", "ideal"],
            "default": "pipeline"
        }
    ]
}
